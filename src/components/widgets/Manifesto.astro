---
type ManifestoItem = {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
};

const items: ManifestoItem[] = [
  {
    title: 'Entender',
    description:
      'Comprende cómo funcionan las tecnologías que forman una infraestructura moderna y cómo se relacionan entre sí.',
    image: 'https://images.unsplash.com/photo-1629654297299-c8506221ca97?auto=format&fit=crop&w=1200&q=85',
    imageAlt: 'Terminal Linux y entorno técnico de infraestructura',
  },
  {
    title: 'Construir',
    description: 'Lleva los conceptos a la práctica mediante laboratorios, configuraciones y proyectos reproducibles.',
    image: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=85',
    imageAlt: 'Infraestructura de servidores y laboratorio tecnológico',
  },
  {
    title: 'Escalar',
    description: 'Conecta automatización, seguridad y observabilidad para construir sistemas preparados para crecer.',
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=85',
    imageAlt: 'Infraestructura cloud y sistemas distribuidos',
  },
];
---

<section
  id="manifiesto"
  class="relative overflow-hidden bg-white py-16 sm:py-20 lg:py-28"
  aria-labelledby="manifesto-title"
>
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-5 flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-primary"></span>

        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-primary"> Filosofía FRAINX </span>

        <span class="h-px w-8 bg-primary"></span>
      </div>

      <h2
        id="manifesto-title"
        class="text-4xl font-bold leading-[1.02] tracking-[-0.04em] text-heading sm:text-5xl lg:text-6xl"
      >
        La infraestructura no son
        <br class="hidden sm:block" />
        herramientas aisladas.
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-muted sm:text-lg sm:leading-8">
        Construir sistemas modernos significa entender cómo cada tecnología, proceso y capa se conecta con las demás.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:mt-16 md:grid-cols-3 lg:gap-8">
      {
        items.map((item) => (
          <article class="group">
            <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
              <img
                src={item.image}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover grayscale-[15%] transition-transform duration-700 group-hover:scale-[1.03]"
              />

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#111827]/50 via-transparent to-transparent"
                aria-hidden="true"
              />

              <div
                class="absolute bottom-4 left-5 right-5 h-px bg-white/30 transition-all duration-500 group-hover:bg-primary"
                aria-hidden="true"
              />
            </div>

            <div class="pt-6">
              <h3 class="text-2xl font-semibold tracking-[-0.025em] text-heading transition-colors duration-300 group-hover:text-primary sm:text-3xl">
                {item.title}
              </h3>

              <p class="mt-3 text-base leading-7 text-muted">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex items-center gap-5 sm:mt-16">
      <div class="h-px flex-1 bg-slate-200"></div>

      <p class="text-center text-xs font-medium uppercase tracking-[0.16em] text-slate-400">
        Del conocimiento a sistemas que funcionan.
      </p>

      <div class="h-px flex-1 bg-slate-200"></div>
    </div>
  </div>
</section>
