---
import { Icon } from 'astro-icon/components';

type Node = {
  label: string;
  icon: string;
  x: number;
  y: number;
  size?: 'sm' | 'md' | 'lg';
};

const nodes: Node[] = [
  {
    label: 'AI',
    icon: 'tabler:brain',
    x: 76,
    y: 18,
    size: 'lg',
  },
  {
    label: 'Cloud',
    icon: 'tabler:cloud',
    x: 34,
    y: 34,
    size: 'md',
  },
  {
    label: 'DevOps',
    icon: 'tabler:git-branch',
    x: 68,
    y: 45,
    size: 'md',
  },
  {
    label: 'Docker',
    icon: 'tabler:brand-docker',
    x: 28,
    y: 62,
    size: 'md',
  },
  {
    label: 'Linux',
    icon: 'tabler:terminal-2',
    x: 57,
    y: 78,
    size: 'lg',
  },
  {
    label: 'Network',
    icon: 'tabler:network',
    x: 84,
    y: 68,
    size: 'sm',
  },
];

const sizeClasses = {
  sm: {
    wrapper: 'h-12 w-12',
    icon: 'text-lg',
  },
  md: {
    wrapper: 'h-14 w-14',
    icon: 'text-xl',
  },
  lg: {
    wrapper: 'h-16 w-16',
    icon: 'text-2xl',
  },
};
---

<div
  class="relative mx-auto aspect-square w-full max-w-[520px]"
  aria-label="Visualización de infraestructura tecnológica FRAINX"
  role="img"
>
  <!-- Ambient glow -->
  <div
    class="absolute left-1/2 top-1/2 h-[55%] w-[55%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <!-- Technical grid -->
  <div
    class="absolute inset-[7%] rounded-3xl opacity-70"
    aria-hidden="true"
    style="
      background-image:
        linear-gradient(to right, rgba(37, 99, 235, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(37, 99, 235, 0.08) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
    "
  >
  </div>

  <!-- Outer technical frame -->
  <div class="absolute inset-[7%] rounded-[2rem] border border-slate-200/80 bg-white/40" aria-hidden="true"></div>

  <!-- Corner markers -->
  <div class="absolute left-[7%] top-[7%] h-5 w-5 border-l-2 border-t-2 border-primary" aria-hidden="true"></div>
  <div class="absolute right-[7%] top-[7%] h-5 w-5 border-r-2 border-t-2 border-primary" aria-hidden="true"></div>
  <div class="absolute bottom-[7%] left-[7%] h-5 w-5 border-b-2 border-l-2 border-primary" aria-hidden="true"></div>
  <div class="absolute bottom-[7%] right-[7%] h-5 w-5 border-b-2 border-r-2 border-primary" aria-hidden="true"></div>

  <!-- SVG connection system -->
  <svg
    class="absolute inset-[10%] h-[80%] w-[80%] overflow-visible"
    viewBox="0 0 100 100"
    fill="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="line-gradient" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#2563EB" stop-opacity="0.15"></stop>
        <stop offset="50%" stop-color="#2563EB" stop-opacity="0.65"></stop>
        <stop offset="100%" stop-color="#2563EB" stop-opacity="0.12"></stop>
      </linearGradient>

      <filter id="soft-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="1.8" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- Primary connections -->
    <path d="M76 18 L68 45 L57 78" stroke="url(#line-gradient)" stroke-width="0.7"></path>
    <path d="M34 34 L68 45 L84 68" stroke="url(#line-gradient)" stroke-width="0.7"></path>
    <path d="M28 62 L57 78 L84 68" stroke="url(#line-gradient)" stroke-width="0.7"></path>
    <path d="M34 34 L28 62" stroke="url(#line-gradient)" stroke-width="0.5"></path>
    <path d="M76 18 L84 68" stroke="url(#line-gradient)" stroke-width="0.5"></path>

    <!-- Secondary technical paths -->
    <path
      d="M22 47 C38 19 65 15 88 37"
      stroke="#2563EB"
      stroke-opacity="0.12"
      stroke-width="0.45"
      stroke-dasharray="2 3"></path>
    <path
      d="M20 76 C42 88 70 88 91 55"
      stroke="#2563EB"
      stroke-opacity="0.12"
      stroke-width="0.45"
      stroke-dasharray="2 3"></path>

    <!-- Connection points -->
    <circle cx="76" cy="18" r="1.7" fill="#2563EB" filter="url(#soft-glow)"></circle>
    <circle cx="34" cy="34" r="1.3" fill="#2563EB"></circle>
    <circle cx="68" cy="45" r="1.5" fill="#2563EB"></circle>
    <circle cx="28" cy="62" r="1.3" fill="#2563EB"></circle>
    <circle cx="57" cy="78" r="1.7" fill="#2563EB" filter="url(#soft-glow)"></circle>
    <circle cx="84" cy="68" r="1.2" fill="#2563EB"></circle>

    <!-- Small infrastructure signals -->
    <circle cx="48" cy="25" r="0.8" fill="#334155" fill-opacity="0.35"></circle>
    <circle cx="53" cy="55" r="0.8" fill="#334155" fill-opacity="0.35"></circle>
    <circle cx="42" cy="70" r="0.8" fill="#334155" fill-opacity="0.35"></circle>
    <circle cx="73" cy="58" r="0.8" fill="#334155" fill-opacity="0.35"></circle>
  </svg>

  <!-- Infrastructure nodes -->
  {
    nodes.map((node) => {
      const size = sizeClasses[node.size ?? 'md'];

      return (
        <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left: ${node.x}%; top: ${node.y}%;`}>
          <div class="group relative">
            <div
              class={`absolute inset-0 rounded-2xl bg-primary/15 blur-xl transition-all duration-500 group-hover:bg-primary/25 ${size.wrapper}`}
              aria-hidden="true"
            />

            <div
              class={`relative flex items-center justify-center rounded-2xl border border-slate-200 bg-white shadow-[0_12px_35px_rgba(15,23,42,0.08)] transition-all duration-300 group-hover:-translate-y-1 group-hover:border-primary/40 group-hover:shadow-[0_18px_45px_rgba(37,99,235,0.15)] ${size.wrapper}`}
            >
              <Icon name={node.icon} class={size.icon + ' text-primary'} />

              <span class="absolute -bottom-7 left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-400">
                {node.label}
              </span>
            </div>
          </div>
        </div>
      );
    })
  }

  <!-- Central system indicator -->
  <div class="absolute left-[57%] top-[45%] -translate-x-1/2 -translate-y-1/2">
    <div class="relative flex h-7 w-7 items-center justify-center">
      <span class="absolute inset-0 animate-ping rounded-full bg-primary/10"></span>
      <span class="relative h-2.5 w-2.5 rounded-full bg-primary shadow-[0_0_18px_rgba(37,99,235,0.65)]"></span>
    </div>
  </div>

  <!-- Technical labels -->
  <div
    class="absolute left-[12%] top-[20%] hidden text-[9px] font-medium uppercase tracking-[0.2em] text-slate-400 sm:block"
  >
    SYSTEM
  </div>

  <div
    class="absolute bottom-[18%] right-[12%] hidden text-[9px] font-medium uppercase tracking-[0.2em] text-slate-400 sm:block"
  >
    INFRA / 01
  </div>
</div>
