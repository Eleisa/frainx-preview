---
import { Icon } from 'astro-icon/components';

type InfrastructureItem = {
  name: string;
  description: string;
  icon: string;
  level: string;
  featured?: boolean;
};

type InfrastructureGroup = {
  number: string;
  name: string;
  description: string;
  items: InfrastructureItem[];
};

const groups: InfrastructureGroup[] = [
  {
    number: '01',
    name: 'Inteligencia',
    description: 'Sistemas preparados para cargas de inteligencia artificial.',
    items: [
      {
        name: 'AI Infrastructure',
        description: 'Infraestructura para ejecutar y operar cargas de IA.',
        icon: 'tabler:brain',
        level: 'INTELLIGENCE',
        featured: true,
      },
      {
        name: 'LLMOps',
        description: 'Operación, despliegue y observabilidad de sistemas con LLM.',
        icon: 'tabler:robot',
        level: 'INTELLIGENCE',
      },
    ],
  },
  {
    number: '02',
    name: 'Operaciones',
    description: 'Automatización y prácticas para construir sistemas reproducibles.',
    items: [
      {
        name: 'DevOps',
        description: 'Integración, entrega y operación continua.',
        icon: 'tabler:git-branch',
        level: 'OPERATIONS',
      },
      {
        name: 'Automation',
        description: 'Procesos automatizados para reducir tareas repetitivas.',
        icon: 'tabler:settings-automation',
        level: 'OPERATIONS',
      },
    ],
  },
  {
    number: '03',
    name: 'Plataforma',
    description: 'Los entornos donde viven y evolucionan las aplicaciones.',
    items: [
      {
        name: 'Cloud',
        description: 'Infraestructura distribuida, flexible y escalable.',
        icon: 'tabler:cloud',
        level: 'PLATFORM',
      },
      {
        name: 'Observability',
        description: 'Métricas, logs y trazabilidad para entender los sistemas.',
        icon: 'tabler:chart-dots-3',
        level: 'PLATFORM',
      },
    ],
  },
  {
    number: '04',
    name: 'Conectividad',
    description: 'Comunicación y protección entre sistemas y servicios.',
    items: [
      {
        name: 'Networking',
        description: 'Redes que conectan aplicaciones, servicios e infraestructura.',
        icon: 'tabler:network',
        level: 'CONNECTIVITY',
      },
      {
        name: 'Security',
        description: 'Controles y prácticas para proteger la infraestructura.',
        icon: 'tabler:shield-lock',
        level: 'CONNECTIVITY',
      },
    ],
  },
  {
    number: '05',
    name: 'Fundamentos',
    description: 'La base sobre la que se construye todo el sistema.',
    items: [
      {
        name: 'Docker',
        description: 'Contenedores y entornos reproducibles.',
        icon: 'tabler:brand-docker',
        level: 'FOUNDATION',
      },
      {
        name: 'Linux',
        description: 'La base de gran parte de la infraestructura moderna.',
        icon: 'tabler:terminal-2',
        level: 'FOUNDATION',
        featured: true,
      },
    ],
  },
];
---

<section
  id="infraestructura"
  class="relative overflow-hidden bg-[#334155] py-16 text-white sm:py-20 lg:py-24"
  aria-labelledby="infrastructure-title"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.06]"
    aria-hidden="true"
    style="
      background-image:
        linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px);
      background-size: 48px 48px;
    "
  >
  </div>

  <div
    class="pointer-events-none absolute right-[-10%] top-[-15%] h-[500px] w-[500px] rounded-full bg-primary/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute bottom-[-20%] left-[-10%] h-[450px] w-[450px] rounded-full bg-primary/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <div class="mb-14 sm:mb-16 lg:mb-20">
            <div class="flex items-center gap-4">
              <span class="h-px w-10 bg-blue-400"></span>

              <span class="text-lg font-semibold uppercase tracking-[0.14em] text-white sm:text-xl">
                Infraestructura
              </span>
            </div>
          </div>
          <h2
            id="infrastructure-title"
            class="max-w-lg text-4xl font-bold leading-[1.02] tracking-[-0.04em] sm:text-5xl lg:text-6xl"
          >
            Todo está
            <br />
            conectado.
          </h2>

          <p class="mt-6 max-w-md text-base leading-7 text-slate-200 sm:text-lg sm:leading-8">
            Una infraestructura moderna no está formada por herramientas aisladas. Cada componente cumple una función y
            se relaciona con los demás.
          </p>

          <div class="mt-8 hidden items-center gap-3 lg:flex">
            <span class="h-2 w-2 bg-blue-400 shadow-[0_0_12px_rgba(96,165,250,0.8)]"></span>

            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-300">
              FRAINX / INFRASTRUCTURE MAP
            </span>
          </div>

          <div class="mt-10 hidden border-l border-white/10 pl-5 lg:block">
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-slate-400">De la base a la inteligencia</p>

            <div class="mt-4 space-y-3">
              {
                groups
                  .slice()
                  .reverse()
                  .map((group) => (
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-[10px] text-blue-300">{group.number}</span>

                      <span class="text-sm text-slate-300">{group.name}</span>
                    </div>
                  ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="relative lg:col-span-8">
        <div
          class="pointer-events-none absolute bottom-0 left-[7px] top-0 hidden w-px bg-white/10 sm:block"
          aria-hidden="true"
        >
        </div>

        <div class="relative space-y-8 sm:space-y-10">
          {
            groups.map((group, groupIndex) => (
              <div class="relative">
                <div
                  class="absolute -left-[1px] top-1.5 hidden h-4 w-4 items-center justify-center border border-blue-400 bg-[#334155] sm:flex"
                  aria-hidden="true"
                >
                  <span class="h-1.5 w-1.5 bg-blue-400" />
                </div>

                <div class="sm:pl-10">
                  <div class="mb-4 flex items-baseline gap-4">
                    <span class="font-mono text-sm font-semibold tracking-[0.08em] text-blue-300">{group.number}</span>

                    <h3 class="text-xl font-semibold tracking-[-0.02em] text-white sm:text-2xl">{group.name}</h3>

                    <span class="hidden h-px flex-1 bg-white/10 sm:block" />
                  </div>

                  <p class="mb-5 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">{group.description}</p>

                  <div class="grid gap-4 sm:grid-cols-2">
                    {group.items.map((item) => (
                      <article
                        class={`group relative overflow-hidden rounded-md border p-5 transition-all duration-300 sm:p-6 ${
                          item.featured
                            ? 'border-blue-400/40 bg-white/[0.09] hover:border-blue-300/70 hover:bg-white/[0.13]'
                            : 'border-white/10 bg-white/[0.045] hover:border-white/20 hover:bg-white/[0.08]'
                        }`}
                      >
                        <div class="flex items-start justify-between gap-4">
                          <div
                            class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-sm ${
                              item.featured ? 'bg-primary text-white' : 'bg-white/10 text-blue-300'
                            }`}
                          >
                            <Icon name={item.icon} class="text-xl" />
                          </div>

                          <span class="text-[9px] font-semibold uppercase tracking-[0.18em] text-slate-400">
                            {item.level}
                          </span>
                        </div>

                        <h4 class="mt-7 text-xl font-semibold tracking-[-0.02em] text-white sm:text-2xl">
                          {item.name}
                        </h4>

                        <p class="mt-3 text-sm leading-6 text-slate-300 sm:text-base">{item.description}</p>

                        <div class="mt-6 flex items-center justify-between">
                          <span class="h-px w-8 bg-white/20 transition-all duration-300 group-hover:w-14 group-hover:bg-blue-400" />

                          <div
                            class="flex h-9 w-9 items-center justify-center rounded-sm border border-white/10 text-slate-500 transition-all duration-300 group-hover:border-blue-400/40 group-hover:bg-primary group-hover:text-white"
                            aria-hidden="true"
                          >
                            <Icon name="tabler:arrow-up-right" class="text-base" />
                          </div>
                        </div>

                        <div
                          class="pointer-events-none absolute bottom-0 left-0 h-px w-0 bg-primary transition-all duration-500 group-hover:w-full"
                          aria-hidden="true"
                        />
                      </article>
                    ))}
                  </div>
                </div>

                {groupIndex < groups.length - 1 && (
                  <div class="ml-0 flex h-8 items-center sm:ml-0" aria-hidden="true">
                    <div class="hidden h-px w-10 bg-white/10 sm:block" />
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
